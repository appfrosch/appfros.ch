---
import { getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageBody from '../components/pages/PageBody.astro';

const about = await getEntry('pages', 'en/about');
const { title, description } = about!.data;
---

<BaseLayout title={`${title} | Appfrosch`} description={description} lang="en">
	<PageBody page="about" lang="en" />
</BaseLayout>
